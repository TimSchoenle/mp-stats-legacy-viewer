{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "github>TimSchoenle/actions//configs/renovate/default"
  ],
  "packageRules": [
    {
      "matchPackageNames": [
        "dtolnay/rust-toolchain",
        "aquasecurity/trivy-action",
        "taiki-e/install-action"
      ],
      "enabled": false
    },
    {
      "groupName": "dioxus packages",
      "matchPackageNames": [
        "/^dioxus/"
      ]
    },
    {
      "description": "The Rust toolchain moves in one pull request: `rust-toolchain.toml` and the `rust:<version>-slim` base image in the Dockerfile name the same release and must not drift apart. Digest updates (same release, rebuilt image) stay ungrouped.",
      "groupName": "rust toolchain",
      "matchDepNames": [
        "rust"
      ],
      "matchUpdateTypes": [
        "major",
        "minor",
        "patch"
      ]
    }
  ]
}
